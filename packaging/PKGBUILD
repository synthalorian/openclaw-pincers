# Maintainer: OpenClaw Community
# AUR-style source build for Arch Linux / CachyOS / Manjaro.
# Build with: makepkg -si

pkgname=openclaw-pincers
pkgver=0.1.0
pkgrel=1
pkgdesc="Get a grip on your gateway — desktop control center for OpenClaw"
arch=('x86_64' 'aarch64')
url="https://github.com/synthalorian/openclaw-desktop"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libsoup3'
  'libayatana-appindicator'
)
makedepends=(
  'rust'
  'cargo'
  'nodejs'
  'npm'
)
source=()
sha256sums=()

# NOTE: run makepkg from the repository root (this file lives in packaging/).
# The build uses the checked-out source tree directly.

build() {
  cd "$startdir/.."
  npm ci
  npm run tauri build -- --bundles none
}

package() {
  cd "$startdir/.."
  install -Dm755 "src-tauri/target/release/openclaw-desktop" \
    "$pkgdir/usr/bin/openclaw-pincers"

  install -Dm644 "packaging/openclaw-pincers.desktop" \
    "$pkgdir/usr/share/applications/openclaw-pincers.desktop"

  install -Dm644 "src-tauri/icons/128x128.png" \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/openclaw-pincers.png"

  install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
